# Copy to .env for local development. Never commit the real .env file.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Set to False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins. Usually not needed for this API.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Bearer token the Agentplace agent must send. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STORE_API_TOKEN=change-me

# Optional. Defaults to ./db.sqlite3. In production, point this to persistent
# storage outside the repository, e.g. /var/lib/store-api/db.sqlite3
SQLITE_PATH=
